#!/usr/bin/env python3
"""TBTX kinetic-hyperframes template (approved look). One small spec -> hyperframes projects -> renders ->
frame_check.py gate. Exit code 1 if ANY output fails frame_check. Never hand-build layouts; edit the spec.

  python3 build.py spec.json            # renders every format listed in the spec
  python3 build.py                      # no spec: PROOF post 1 defaults (approved copy, approved look)

Spec (all optional; defaults = PROOF post 1):
{
  "name": "post1",
  "out": "/root/tbtx-next-ecosystem/hermes/out/post1-hyperframes-v2",
  "duration": 13.5,                    # 8-20 s (frame_check fails outside)
  "accent": "#d01e98",                 # brand colour: key-word TEXT colour only (~10% of frame)
  "mode": "plate",                     # "plate" (cinematic image/clip behind type, preferred) | "type" (designed graphite base)
  "plate": {"clip": "/abs/veo.mp4", "still": "/abs/still.png"},   # clip wins for video, still for images
  "beats": [{"text": "AI tools increase *output*,", "fx": "grow"}, ...],   # *stars* = accent words
  "formats": ["9x16", "1x1"],          # video formats: 9x16=1080x1920, 1x1=1080x1080
  "stills": [{"format": "4x5", "name": "post1_static", "main": "*The Context Gap*",
              "sub": "AI tools increase output, but context doesn't keep up, so humans fill the gap."}]
}
fx: rise | grow (accent word scales up: increase) | lag (words arrive late: falling behind) |
    close (words grow out from the centre and fill the row: fill the gap) |
    split (rows start collapsed and pull apart: a gap opens) | stall (words decelerate, last word hits a hard stop,
    and the camera push stops with it).
Round 2 (Erik 2026-10-22): plates must READ (lit, photoreal); scrim is LOCAL behind the text block only;
text is never semi-transparent (hard cuts + slide/scale moves); 9:16 first beat fills >= 50% of frame height;
unknown spec keys are rejected; "name" is required in a spec file; out defaults to hermes/out/<name> and a
folder owned by another job (.job marker) is never overwritten; failing outputs are renamed <file>.FAILED
(not deliverable); "approved_copy" (optional list of strings) must match the spec copy word for word.
Rules baked in (DESIGN-GUIDE + Erik): no flat black, near-white type, accent = text colour, never a block,
big type fitted to an 84% column, 8% safe margins, motion never leaves the safe box, no URL, silent."""
import hashlib, json, os, shutil, subprocess, sys

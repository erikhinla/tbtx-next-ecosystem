SPEC_KEYS = {"name", "out", "duration", "accent", "mode", "plate", "plate_prompt", "beats", "formats", "stills", "approved_copy"}
BEAT_KEYS = {"text", "fx", "sub"}; STILL_KEYS = {"format", "name", "main", "sub"}
PLATE_KEYS = {"still", "clip"} | set(FMT); FXS = {"rise", "grow", "lag", "close", "split", "stall"}
def norm(t): return " ".join(t.replace("*", "").upper().split())
def validate(spec):
    err = []
    bad = set(spec) - SPEC_KEYS
    if bad: err.append(f"unknown spec key(s) {sorted(bad)}; allowed: {sorted(SPEC_KEYS)}")
    for i, b in enumerate(spec.get("beats") or []):
        if set(b) - BEAT_KEYS: err.append(f"beats[{i}] unknown key(s) {sorted(set(b) - BEAT_KEYS)}; allowed {sorted(BEAT_KEYS)}")
        if "text" not in b: err.append(f"beats[{i}] needs 'text'")
        if b.get("fx", "rise") not in FXS: err.append(f"beats[{i}] fx '{b.get('fx')}' not in {sorted(FXS)}")
    for i, st in enumerate(spec.get("stills") or []):
        if set(st) - STILL_KEYS: err.append(f"stills[{i}] unknown key(s) {sorted(set(st) - STILL_KEYS)}; allowed {sorted(STILL_KEYS)}")
        if "main" not in st: err.append(f"stills[{i}] needs 'main'")
        if st.get("format", "4x5") not in FMT: err.append(f"stills[{i}] format not in {sorted(FMT)}")
    if set(spec.get("plate") or {}) - PLATE_KEYS: err.append(f"plate unknown key(s); allowed {sorted(PLATE_KEYS)}")
    for f in spec.get("formats") or []:
        if f not in FMT: err.append(f"format '{f}' not in {sorted(FMT)}")
    if spec.get("mode", "plate") not in ("plate", "type"): err.append("mode must be 'plate' or 'type'")
    if "approved_copy" in spec:
        have = [b["text"] for b in spec.get("beats") or []] if spec.get("formats") else []
        for st in spec.get("stills") or []: have += [st["main"]] + ([st["sub"]] if st.get("sub") else [])
        want = [norm(x) for x in spec["approved_copy"]]
        if norm(" ".join(have)) != norm(" ".join(spec["approved_copy"])):
            err.append("COPY LOCK: spec copy does not match approved_copy word for word.\n  approved: "
                       + " | ".join(want) + "\n  spec:     " + " | ".join(norm(h) for h in have))
    if err: sys.exit("SPEC ERROR:\n- " + "\n- ".join(err))
F = {}
def font(s):
    if s not in F: F[s] = ImageFont.truetype(FONT, s)
    return F[s]
def tok(text):  # -> [(WORD, accent)]
    out, acc = [], False
    for w in text.split():
        a = acc or w.startswith("*"); acc = (a and not w.rstrip(".,;:").endswith("*"))
        out.append((w.replace("*", "").upper(), a))
    return out
def width(words, s):
    t = " ".join(w for w, _ in words)
    return font(s).getlength(t) + LS * s * len(t)
def splits(n, k):
    if k == 1: yield [n]; return
    for i in range(1, n - k + 2):
        for r in splits(n - i, k - 1): yield [i] + r
def layout(words, W, H, hero=False):
    """Poster stack: every row fitted to the column; accent row(s) never smaller than support rows.
    hero=True (9:16 first beat): one word per row allowed bigger, so the block fills >= half the frame."""
    colw = W * COL * 0.975; safeh = H * (1 - 0.16) * 0.86
    cap = H * (0.30 if hero else 0.20 if H > W else 0.27)
    best = None
    for k in range(1, min(5, len(words)) + 1):
        for sp in splits(len(words), k):
            rows, i = [], 0
            for n in sp: rows.append(words[i:i + n]); i += n
            sz = [min(cap, colw / (width(r, 100) / 100)) for r in rows]
            acc = [any(a for _, a in r) for r in rows]
            if any(acc) and not all(acc):
                amax = max(s for s, a in zip(sz, acc) if a)
                sz = [s if a else min(s, amax * 0.92) for s, a in zip(sz, acc)]
            tot = sum(s * LH for s in sz)
            mn = min(sz); sz = [min(s, mn * (2.6 if hero else 1.8)) for s in sz]          # no row more than 1.8x another
            if any(acc) and not all(acc):                                  # accent row stays the largest
                amax = max(s for s, a in zip(sz, acc) if a); sz = [s if a else min(s, amax * 0.92) for s, a in zip(sz, acc)]
            tot = sum(s * LH for s in sz)
            if tot > safeh: sz = [s * safeh / tot for s in sz]
            area = sum(width(r, 100) / 100 * s * s * 0.72 for r, s in zip(rows, sz))
            ratio = max(sz) / min(sz)
            # split accent phrase across rows only if each part is >1 word
            score = area * (0.8 if ratio > 2.4 and not hero else 1) * (0.9 ** max(0, k - 3)) * ((tot / H) ** 2 if hero else 1)
            if best is None or score > best[0]: best = (score, rows, [int(s) for s in sz], area / (W * H * 0.84 * 0.84))
    return best[1], best[2], best[3]
def wrap_sub(text, W, s, maxw):
    ws, rows, cur = text.split(), [], ""
    for w in ws:
        t = (cur + " " + w).strip()
        if font(s).getlength(t.upper()) + LS * s * len(t) > maxw and cur: rows.append(cur); cur = w
        else: cur = t
    rows.append(cur); return rows
def esc(s): return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("'", "&#39;")
def beat_html(i, rows, sizes, sy=1.0, sub=""):
    h = [f'<div class="beat" id="b{i}"><div class="blk">']
    for r, s in zip(rows, sizes):
        ws = " ".join(f'<span class="w{" k" if a else ""}">{esc(w)}</span>' for w, a in r)
        h.append(f'<div class="row" style="font-size:{s}px' + (f';transform:scaleY({sy:.3f});margin:{(sy-1)*s*LH/2:.1f}px 0' if sy != 1.0 else '') + f'">{ws}</div>')
    return "\n".join(h + [sub + "</div></div><!--/beat-->"])
FX_IN = {"rise": 0.8, "grow": 1.5, "lag": 1.6, "close": 1.2, "split": 1.3, "stall": 2.0}
def timeline_js(beats, D):
    """GSAP timeline + manifest beat windows. Every motion stays inside the safe box (inward/vertical only)."""
    wts = [len(b["words"]) + 2.2 for b in beats]; tot = sum(wts); t = 0.25; js = []; man = []
    for i, b in enumerate(beats):
        last = i == len(beats) - 1
        span = (D - 0.25) * wts[i] / tot
        fin = FX_IN.get(b["fx"], 0.8); out = 0
        s, e = t, t + span
        sel = f"#b{i}"
        js.append(f'tl.set("{sel}",{{opacity:1}},{s:.3f});')
        fx = b["fx"]
        if fx == "grow":
            js.append(f'tl.from("{sel} .w:not(.k)",{{yPercent:60,duration:0.45,stagger:0.08,ease:"power3.out"}},{s:.3f});')
            js.append(f'tl.from("{sel} .k",{{scale:0.32,transformOrigin:"50% 70%",duration:0.9,ease:"expo.out"}},{s+0.4:.3f});')
        elif fx == "lag":
            js.append(f'tl.from("{sel} .w",{{yPercent:-45,duration:(i)=>0.45+i*0.18,stagger:(i)=>i*i*0.05,ease:"power2.out"}},{s:.3f});')
        elif fx == "close":
            js.append(f'gsap.utils.toArray("{sel} .row").forEach((r)=>{{const ws=r.querySelectorAll(".w");const c=r.getBoundingClientRect();'
                      f'ws.forEach((w,j)=>{{const b=w.getBoundingClientRect();const dx=(c.left+c.width/2)-(b.left+b.width/2);'
                      f'tl.from(w,{{x:dx*0.85,scaleX:0.2,duration:0.9,ease:"power4.out"}},{s:.3f}+j*0.06);}});}});')
        elif fx == "split":
            js.append(f'gsap.utils.toArray("{sel} .row").forEach((r,j,a)=>{{const m=(a.length-1)/2;'
                      f'tl.from(r,{{yPercent:(m-j)*70,scale:0.94,duration:1.0,ease:"expo.out"}},{s:.3f});}});')
        elif fx == "stall":
            js.append(f'tl.from("{sel} .w",{{yPercent:40,duration:0.35,stagger:(i,el,a)=>0.12*i+0.03*i*i,ease:"power2.out"}},{s:.3f});')
            js.append(f'tl.to("{sel} .w:last-child",{{keyframes:[{{y:-10,duration:0.06}},{{y:5,duration:0.06}},{{y:0,duration:0.08}}]}},{s+fin:.3f});')
        else:
            js.append(f'tl.from("{sel} .w",{{yPercent:50,duration:0.45,stagger:0.07,ease:"power3.out"}},{s:.3f});')
        if b.get("sub"):
            js.append(f'tl.from("{sel} .sub",{{yPercent:30,duration:0.45,ease:"power3.out"}},{s+0.5:.3f});')
        if not last:
            js.append(f'tl.set("{sel}",{{opacity:0}},{e:.3f});')   # hard cut out: text is never semi-transparent
        man.append({"start": round(s, 3), "end": round(e, 3), "hold": [round(s + fin + 0.1, 3), round(e - out - 0.05, 3)]})
        t = e
    stall_t = man[-1]["hold"][0] if beats[-1]["fx"] == "stall" else D
    return "\n".join(js), man, stall_t
CSS = """

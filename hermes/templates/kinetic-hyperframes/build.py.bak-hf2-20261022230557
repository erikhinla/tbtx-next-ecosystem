<title>{esc(spec.get('name','tbtx'))} {fmt}</title>
<script src="assets/gsap.min.js"></script>
<style>{css}</style></head>
<body>
<div id="root" data-composition-id="main" data-start="0" data-duration="{D}" data-width="{W}" data-height="{H}" data-fps="30" style="--accent:{acc}">
{vid}
<div id="stage" class="clip" data-start="0" data-duration="{D}" data-track-index="1" style="z-index:1">
{layers}
{chr(10).join(htmlb)}
</div>
</div>
<script>
window.__timelines = window.__timelines || {{}};
const tl = gsap.timeline({{ paused: true }});
{push}
tl.fromTo("#sheen",{{xPercent:-18}},{{xPercent:14,duration:{D},ease:"none"}},0);
tl.fromTo("#grain",{{x:0,y:0}},{{x:-40,y:-28,duration:{D},ease:"steps({int(D*12)})"}},0);
{js}
tl.set({{}},{{}},{D});

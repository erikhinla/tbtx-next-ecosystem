#!/usr/bin/env python3
"""TBTX kinetic-hyperframes template (approved look). One small spec -> hyperframes projects -> renders ->
frame_check.py gate. Exit code 1 if ANY output fails frame_check. Never hand-build layouts; edit the spec.

  python3 build.py spec.json            # renders every format listed in the spec
  python3 build.py                      # no spec: PROOF post 1 defaults (approved copy, approved look)

Spec (all optional; defaults = PROOF post 1):
{
  "name": "post1",
  "out": "/root/tbtx-next-ecosystem/hermes/out/post1-hyperframes-v2",
  "duration": 13.5,                    # 8-20 s (frame_check fails outside)
  "accent": "#d01e98",                 # brand colour: key-word TEXT colour only (~10% of frame)
  "mode": "plate",                     # "plate" (cinematic image/clip behind type, preferred) | "type" (designed graphite base)
  "plate": {"clip": "/abs/veo.mp4", "still": "/abs/still.png"},   # clip wins for video, still for images
  "beats": [{"text": "AI tools increase *output*,", "fx": "grow"}, ...],   # *stars* = accent words
  "formats": ["9x16", "1x1"],          # video formats: 9x16=1080x1920, 1x1=1080x1080
  "stills": [{"format": "4x5", "name": "post1_static", "main": "*The Context Gap*",
              "sub": "AI tools increase output, but context doesn't keep up, so humans fill the gap."}]
}
fx: rise | grow (accent word scales up: increase) | lag (words arrive late: falling behind) |
    close (words grow out from the centre and fill the row: fill the gap) |
    split (rows start collapsed and pull apart: a gap opens) | stall (words decelerate, last word hits a hard stop,
    and the camera push stops with it).
Rules baked in (DESIGN-GUIDE + Erik): no flat black, near-white type, accent = text colour, never a block,
big type fitted to an 84% column, 8% safe margins, motion never leaves the safe box, no URL, silent."""
import hashlib, json, os, shutil, subprocess, sys
from PIL import ImageFont
T = os.path.dirname(os.path.abspath(__file__)); HERMES = os.path.abspath(os.path.join(T, "..", ".."))
FONT = os.path.join(HERMES, "fonts", "ArchivoBlack.ttf")
GSAP = "/usr/local/lib/hermes-agent/node_modules/gsap/dist/gsap.min.js"
FMT = {"9x16": (1080, 1920), "1x1": (1080, 1080), "4x5": (1080, 1350), "16x9": (1920, 1080)}
INK = "#f4f1ea"          # near-white support type (approx 17:1 on the base)
LS = -0.015              # letter-spacing em
LH = 0.9                 # row line-height
COL = 0.84               # type column = 84% of width (8% margins each side)
POST1 = {
    "name": "post1", "duration": 13.5, "accent": "#d01e98", "mode": "plate", "plate": {},
    "plate_prompt": "A vast brushed-steel atrium seen from a low angle: two monumental metal walls separated by a narrow vertical gap of cold light, fog pooling on a polished concrete floor.",
    "out": os.path.join(HERMES, "out", "post1-hyperframes-v2"),
    "beats": [{"text": "AI tools increase *output*,", "fx": "grow"},
              {"text": "but context doesn't keep up,", "fx": "lag"},
              {"text": "so humans fill the gap.", "fx": "close"},
              {"text": "*The Context Gap*", "fx": "split"},
              {"text": "PROOF shows where the work stalls.", "fx": "stall"}],
    "formats": ["9x16", "1x1"], "stills": []}
F = {}
def font(s):
    if s not in F: F[s] = ImageFont.truetype(FONT, s)
    return F[s]
def tok(text):  # -> [(WORD, accent)]
    out, acc = [], False
    for w in text.split():
        a = acc or w.startswith("*"); acc = (a and not w.rstrip(".,;:").endswith("*"))
        out.append((w.replace("*", "").upper(), a))
    return out
def width(words, s):
    t = " ".join(w for w, _ in words)
    return font(s).getlength(t) + LS * s * len(t)
def splits(n, k):
    if k == 1: yield [n]; return
    for i in range(1, n - k + 2):
        for r in splits(n - i, k - 1): yield [i] + r
def layout(words, W, H):
    """Poster stack: every row fitted to the column; accent row(s) never smaller than support rows."""
    colw = W * COL * 0.975; safeh = H * (1 - 0.16) * 0.86
    cap = H * (0.20 if H > W else 0.27)
    best = None
    for k in range(1, min(5, len(words)) + 1):
        for sp in splits(len(words), k):
            rows, i = [], 0
            for n in sp: rows.append(words[i:i + n]); i += n
            sz = [min(cap, colw / (width(r, 100) / 100)) for r in rows]
            acc = [any(a for _, a in r) for r in rows]
            if any(acc) and not all(acc):
                amax = max(s for s, a in zip(sz, acc) if a)
                sz = [s if a else min(s, amax * 0.92) for s, a in zip(sz, acc)]
            tot = sum(s * LH for s in sz)
            mn = min(sz); sz = [min(s, mn * 1.8) for s in sz]          # no row more than 1.8x another
            if any(acc) and not all(acc):                                  # accent row stays the largest
                amax = max(s for s, a in zip(sz, acc) if a); sz = [s if a else min(s, amax * 0.92) for s, a in zip(sz, acc)]
            tot = sum(s * LH for s in sz)
            if tot > safeh: sz = [s * safeh / tot for s in sz]
            area = sum(width(r, 100) / 100 * s * s * 0.72 for r, s in zip(rows, sz))
            ratio = max(sz) / min(sz)
            # split accent phrase across rows only if each part is >1 word
            score = area * (0.8 if ratio > 2.4 else 1) * (0.9 ** max(0, k - 3))
            if best is None or score > best[0]: best = (score, rows, [int(s) for s in sz], area / (W * H * 0.84 * 0.84))
    return best[1], best[2], best[3]
def wrap_sub(text, W, s, maxw):
    ws, rows, cur = text.split(), [], ""
    for w in ws:
        t = (cur + " " + w).strip()
        if font(s).getlength(t.upper()) + LS * s * len(t) > maxw and cur: rows.append(cur); cur = w
        else: cur = t
    rows.append(cur); return rows
def esc(s): return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("'", "&#39;")
def beat_html(i, rows, sizes):
    h = [f'<div class="beat" id="b{i}">']
    for r, s in zip(rows, sizes):
        ws = " ".join(f'<span class="w{" k" if a else ""}">{esc(w)}</span>' for w, a in r)
        h.append(f'<div class="row" style="font-size:{s}px">{ws}</div>')
    return "\n".join(h + ["</div>"])
FX_IN = {"rise": 0.8, "grow": 1.5, "lag": 1.6, "close": 1.2, "split": 1.3, "stall": 2.0}
def timeline_js(beats, D):
    """GSAP timeline + manifest beat windows. Every motion stays inside the safe box (inward/vertical only)."""
    wts = [len(b["words"]) + 2.2 for b in beats]; tot = sum(wts); t = 0.25; js = []; man = []
    for i, b in enumerate(beats):
        last = i == len(beats) - 1
        span = (D - 0.25) * wts[i] / tot
        fin = FX_IN.get(b["fx"], 0.8); out = 0 if last else 0.45
        s, e = t, t + span
        sel = f"#b{i}"
        js.append(f'tl.set("{sel}",{{opacity:1}},{s:.3f});')
        fx = b["fx"]
        if fx == "grow":
            js.append(f'tl.from("{sel} .w:not(.k)",{{yPercent:60,opacity:0,duration:0.6,stagger:0.08,ease:"power3.out"}},{s:.3f});')
            js.append(f'tl.from("{sel} .k",{{scale:0.32,opacity:0,transformOrigin:"50% 70%",duration:1.1,ease:"expo.out"}},{s+0.4:.3f});')
        elif fx == "lag":
            js.append(f'tl.from("{sel} .w",{{yPercent:-45,opacity:0,duration:(i)=>0.45+i*0.18,stagger:(i)=>i*i*0.05,ease:"power2.out"}},{s:.3f});')
        elif fx == "close":
            js.append(f'gsap.utils.toArray("{sel} .row").forEach((r)=>{{const ws=r.querySelectorAll(".w");const c=r.getBoundingClientRect();'
                      f'ws.forEach((w,j)=>{{const b=w.getBoundingClientRect();const dx=(c.left+c.width/2)-(b.left+b.width/2);'
                      f'tl.from(w,{{x:dx*0.85,scaleX:0.2,opacity:0,duration:0.9,ease:"power4.out"}},{s:.3f}+j*0.06);}});}});')
        elif fx == "split":
            js.append(f'gsap.utils.toArray("{sel} .row").forEach((r,j,a)=>{{const m=(a.length-1)/2;'
                      f'tl.from(r,{{yPercent:(m-j)*70,scale:0.94,opacity:0,duration:1.1,ease:"expo.out"}},{s:.3f});}});')
        elif fx == "stall":
            js.append(f'tl.from("{sel} .w",{{yPercent:40,opacity:0,duration:0.35,stagger:(i,el,a)=>0.12*i+0.03*i*i,ease:"power2.out"}},{s:.3f});')
            js.append(f'tl.to("{sel} .w:last-child",{{keyframes:[{{y:-10,duration:0.06}},{{y:5,duration:0.06}},{{y:0,duration:0.08}}]}},{s+fin:.3f});')
        else:
            js.append(f'tl.from("{sel} .w",{{yPercent:50,opacity:0,duration:0.6,stagger:0.07,ease:"power3.out"}},{s:.3f});')
        if b.get("sub"):
            js.append(f'tl.from("{sel} .sub",{{yPercent:30,opacity:0,duration:0.6,ease:"power3.out"}},{s+0.5:.3f});')
        if not last:
            js.append(f'tl.to("{sel}",{{opacity:0,yPercent:-4,duration:{out},ease:"power2.in"}},{e-out:.3f});')
        man.append({"start": round(s, 3), "end": round(e, 3), "hold": [round(s + fin + 0.1, 3), round(e - out - 0.05, 3)]})
        t = e
    stall_t = man[-1]["hold"][0] if beats[-1]["fx"] == "stall" else D
    return "\n".join(js), man, stall_t
CSS = """
@font-face{font-family:'TBTX Display';src:url('assets/fonts/ArchivoBlack.ttf');font-weight:400}
*{margin:0;padding:0;box-sizing:border-box}
html,body{width:%(W)dpx;height:%(H)dpx;overflow:hidden;background:#0d0e11}

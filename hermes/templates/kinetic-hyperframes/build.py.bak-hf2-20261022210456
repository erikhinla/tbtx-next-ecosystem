#brush{inset:-2%%;opacity:.55;background:repeating-linear-gradient(0deg,rgba(255,255,255,.022) 0 1px,rgba(0,0,0,.03) 1px 2px,transparent 2px 4px),
 repeating-linear-gradient(0deg,rgba(255,255,255,.015) 0 1px,transparent 1px 9px)}
#platewrap{overflow:hidden}

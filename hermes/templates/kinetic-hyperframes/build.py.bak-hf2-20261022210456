"""
def build_project(spec, fmt, pdir, still=None):
    W, H = FMT[fmt]; D = float(spec.get("duration", 13.5)); acc = spec.get("accent", "#d01e98")
    if os.path.exists(pdir): shutil.rmtree(pdir)
    os.makedirs(os.path.join(pdir, "assets", "fonts"))
    shutil.copy(FONT, os.path.join(pdir, "assets", "fonts", "ArchivoBlack.ttf")); shutil.copy(GSAP, os.path.join(pdir, "assets", "gsap.min.js"))
    mode = spec.get("mode", "type"); plate = spec.get("plate", {}) or {}
    plate_html = ""; vid = ""; is_clip = False
    if mode == "plate":
        src = plate.get(fmt) or (plate.get("clip") if (still is None and plate.get("clip")) else plate.get("still")) or plate.get("clip")
        if not src:   # no plate given: generate a still for this aspect (gemini image), cached per prompt+aspect
            asp = {"9x16": "9:16", "1x1": "1:1", "4x5": "4:5", "16x9": "16:9"}[fmt]
            pp = spec.get("plate_prompt") or POST1["plate_prompt"]
            cache = os.path.join(HERMES, "out", "plates", f"auto_{hashlib.md5(pp.encode()).hexdigest()[:8]}_{fmt}.png")
            if not os.path.exists(cache):
                os.makedirs(os.path.dirname(cache), exist_ok=True)
                subprocess.run([sys.executable, os.path.join(HERMES, "gen_media.py"), "still", pp, cache, "--aspect", asp], check=True)
            src = cache
        if not os.path.exists(src): sys.exit(f"plate file not found: {src}")
        grade = "eq=brightness=-0.05:contrast=1.06:saturation=0.8"
        if src.lower().endswith((".mp4", ".mov", ".webm")) and still is None:
            is_clip = True
            cd = float(subprocess.check_output(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", src]))
            f = max(1.0, (D + 0.3) / cd)
            vf = (f"setpts={f:.4f}*PTS,minterpolate=fps=30:mi_mode=blend,scale={W}:{H}:force_original_aspect_ratio=increase,"
                  f"crop={W}:{H},{grade},format=yuv420p")
            subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", src, "-vf", vf, "-t", f"{D+0.2:.2f}", "-an", "-c:v", "libx264",
                            "-crf", "14", os.path.join(pdir, "assets", "plate.mp4")], check=True)
            vid = (f'<video id="plate" class="clip" src="assets/plate.mp4" data-start="0" data-duration="{D}" data-track-index="0" '
                   f'muted playsinline style="position:absolute;left:0;top:0;width:{W}px;height:{H}px;object-fit:cover;z-index:0"></video>')
        else:
            if src.lower().endswith((".mp4", ".mov", ".webm")):
                subprocess.run(["ffmpeg", "-v", "error", "-y", "-ss", "2", "-i", src, "-frames:v", "1", os.path.join(pdir, "assets", "_src.png")], check=True)
                src = os.path.join(pdir, "assets", "_src.png")
            vf = f"scale={W}:{H}:force_original_aspect_ratio=increase:flags=lanczos,crop={W}:{H},{grade}"
            subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", src, "-vf", vf, os.path.join(pdir, "assets", "plate.png")], check=True)
            plate_html = '<div class="layer" id="platewrap"><img id="plateimg" src="assets/plate.png" alt=""></div>'
    beats = spec["beats"] if still is None else [{"text": still["main"], "fx": "rise", "sub": still.get("sub")}]
    htmlb = []
    for i, b in enumerate(beats):
        b["words"] = tok(b["text"])
        hh = H * (0.70 if b.get("sub") else 1.0)
        rows, sizes, est = layout(b["words"], W, hh)
        b["est_area"] = est
        bh = beat_html(i, rows, sizes)
        if b.get("sub"):
            ss = int(max(46, min(78, min(sizes) * 0.36)))
            sr = wrap_sub(b["sub"], W, ss, W * COL * 0.95)
            sub = "<br>".join(" ".join(f'<span class="k">{esc(w.strip("*"))}</span>' if w.startswith("*") else esc(w) for w in r.split()) for r in sr)
            bh = bh.replace("</div>\n</div>", "</div>\n" + f'<div class="sub" style="font-size:{ss}px">{sub}</div>\n</div>') if bh.endswith("</div>\n</div>") else bh[:-6] + f'<div class="sub" style="font-size:{ss}px">{sub}</div></div>'
        htmlb.append(bh)
    js, man, stall_t = timeline_js(beats, D)
    sc1, sc2 = (".62", ".38") if mode == "plate" else (".0", ".0")
    css = CSS % {"W": W, "H": H, "INK": INK, "LH": LH, "LS": LS, "SC1": sc1, "SC2": sc2}
    layers = ('<div class="layer" id="base"></div>' + ('<div class="layer" id="brush"></div>' if mode != "plate" else "")
              + plate_html + '<div class="layer" id="sheen"></div><div class="layer" id="scrim"></div><div class="layer" id="vig"></div>'
              + '<div class="layer" id="grain"></div>')
    if is_clip: layers = layers.replace('<div class="layer" id="base"></div>', "")
    push = "" if is_clip else (f'tl.fromTo("#plateimg",{{scale:1.0}},{{scale:1.09,duration:{stall_t:.3f},ease:"power1.out"}},0);' if plate_html else
                                f'tl.fromTo("#base",{{scale:1.0}},{{scale:1.06,duration:{stall_t:.3f},ease:"power1.out"}},0);')
    html = f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width={W}, height={H}">
<title>{esc(spec.get('name','tbtx'))} {fmt}</title>
<script src="assets/gsap.min.js"></script>
<style>{css}</style></head>
<body>
<div id="root" data-composition-id="main" data-start="0" data-duration="{D}" data-width="{W}" data-height="{H}" data-fps="30" style="--accent:{acc}">
{vid}
<div id="stage" class="clip" data-start="0" data-duration="{D}" data-track-index="1" style="z-index:1">
{layers}
{chr(10).join(htmlb)}
</div>
</div>
<script>
window.__timelines = window.__timelines || {{}};
const tl = gsap.timeline({{ paused: true }});
{push}
tl.fromTo("#sheen",{{xPercent:-18}},{{xPercent:14,duration:{D},ease:"none"}},0);
tl.fromTo("#grain",{{x:0,y:0}},{{x:-40,y:-28,duration:{D},ease:"steps({int(D*12)})"}},0);
{js}
tl.set({{}},{{}},{D});
window.__timelines["main"] = tl;
</script>
</body></html>"""
    open(os.path.join(pdir, "index.html"), "w").write(html)
    json.dump({"W": W, "H": H, "duration": D, "accent": acc, "accent_rgb": "rgb(%d,%d,%d)" % tuple(int(acc[i:i + 2], 16) for i in (1, 3, 5)),
               "beats": [] if still is not None else man, "still_t": round(man[0]["hold"][0] + 0.3, 3) if still is not None else None,
               "est_area": [round(b["est_area"], 3) for b in beats], "mode": mode},
              open(os.path.join(pdir, "check.json"), "w"), indent=1)
    json.dump({"id": os.path.basename(pdir), "name": os.path.basename(pdir)}, open(os.path.join(pdir, "meta.json"), "w"))
    return man
def run(spec):
    out = spec.get("out") or os.path.join(HERMES, "out", spec.get("name", "video"))
    os.makedirs(out, exist_ok=True); name = spec.get("name", "video"); results = []
    D = float(spec.get("duration", 13.5))
    if spec.get("beats") and not (8 <= D <= 20): sys.exit(f"duration {D} outside 8-20 s")
    for fmt in spec.get("formats", []):
        pdir = os.path.join(out, f"project_{fmt}"); build_project(json.loads(json.dumps(spec)), fmt, pdir)
        mp4 = os.path.join(out, f"{name}_{fmt}.mp4")
        r = subprocess.run(["hyperframes", "render", pdir, "-o", mp4, "--quality", "delivery", "--fps", "30"], capture_output=True, text=True)
        if r.returncode or not os.path.exists(mp4):
            print(r.stdout[-2000:], r.stderr[-2000:]); sys.exit(f"render failed for {fmt}")
        results.append((pdir, mp4))
    for st in spec.get("stills", []):
        fmt = st.get("format", "4x5"); pdir = os.path.join(out, f"project_{st.get('name','still')}")
        build_project(json.loads(json.dumps(spec)), fmt, pdir, still=st)
        man = json.load(open(os.path.join(pdir, "check.json")))
        png = os.path.join(out, f"{st.get('name','still')}_{fmt}.png")
        W, H = FMT[fmt]
        subprocess.run(["node", os.path.join(HERMES, "dom_probe.mjs"), os.path.join(pdir, "index.html"), str(W), str(H), "",
                        "--shot", str(man["still_t"]), png], check=True, capture_output=True)
        results.append((pdir, png))
    bad = 0
    for pdir, media in results:
        print(f"== frame_check {media}")
        r = subprocess.run([sys.executable, os.path.join(HERMES, "frame_check.py"), pdir, media], capture_output=True, text=True)
        print(r.stdout.strip() or r.stderr.strip()); bad += r.returncode != 0
    if bad: print(f"BUILD FAILED: {bad} output(s) failed frame_check. Do not deliver them."); sys.exit(1)
    print("BUILD PASS: every output passed frame_check.")
if __name__ == "__main__":
    spec = dict(POST1)
    if len(sys.argv) > 1: spec.update(json.load(open(sys.argv[1])))
    run(spec)
